{
  "expo": {
    "name": "st-kizito",
    "slug": "st-kizito",
    "scheme": "st-kizito",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#061328"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dave.js.stkizito",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.dave.js.stkizito",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "St. Kizito needs access to your photos so you can attach a payment receipt to your Mass booking."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#061328",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#E6F4FE",
          "sounds": [
            "./assets/sounds/notification.wav"
          ]
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b843ec8a-4ccf-4218-bdfb-e9816aa38a5d"
      }
    },
    "owner": "dave.js",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/b843ec8a-4ccf-4218-bdfb-e9816aa38a5d",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "jsEngine": "hermes"
  }
}
